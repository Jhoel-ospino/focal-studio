{
  "name": "focal-studio-designer",
  "version": "1.0.0",
  "private": true,
  "description": "Visual UI Designer for Focal CNC Laser 480x320 TFT 3.5\"",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
